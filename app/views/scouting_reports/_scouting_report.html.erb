<div id="<%= dom_id scouting_report %>">
  <div>
    <strong>Player name:</strong>
    <%= scouting_report.player_name %>
  </div>

  <div>
    <strong>Position:</strong>
    <%= scouting_report.position %>
  </div>

  <div>
    <strong>College:</strong>
    <%= scouting_report.college %>
  </div>

  <div>
    <strong>Height:</strong>
    <%= scouting_report.height %>
  </div>

  <div>
    <strong>Weight:</strong>
    <%= scouting_report.weight %>
  </div>

  <div>
    <strong>Age:</strong>
    <%= scouting_report.age %>
  </div>

  <div>
    <strong>Positives:</strong>
    <%= scouting_report.positives %>
  </div>

  <div>
    <strong>Negatives:</strong>
    <%= scouting_report.negatives %>
  </div>

  <div>
    <strong>Comments:</strong>
    <%= scouting_report.comments %>
  </div>

  <div>
    <strong>Grade:</strong>
    <%= scouting_report.grade %>
  </div>

</div>
